{
  "Format": "2.9.0",
  "ConfigSchema": {
    "BasilSource": {
      "AllowValues": "Auto, Ours, Cornucopia",
      "Default": "Auto"
    }
  },
  "DynamicTokens": [
    {
      "Name": "ActiveBasil",
      "Value": "Ours"
    },
    {
      "Name": "ActiveBasil",
      "Value": "Cornucopia",
      "When": {
        "HasMod": "Cornucopia.MoreCrops",
        "BasilSource": "Auto, Cornucopia"
      }
    },
    {
      "Name": "BasilItemId",
      "Value": "{{ModId}}_Basil"
    },
    {
      "Name": "BasilItemId",
      "Value": "Cornucopia_Basil",
      "When": {
        "ActiveBasil": "Cornucopia"
      }
    }
  ],
  "Changes": [
    {
      "LogName": "Heirloom tomato object sprites (placeholder art)",
      "Action": "Load",
      "Target": "Mods/{{ModId}}/Objects",
      "FromFile": "assets/sprites/objects.png"
    },
    {
      "LogName": "Heirloom tomato crop growth sprites (draft art)",
      "Action": "Load",
      "Target": "Mods/{{ModId}}/Crops",
      "FromFile": "assets/sprites/crops.png"
    },
    {
      "LogName": "Heirloom tomato and basil harvest objects",
      "Action": "Include",
      "FromFile": "assets/json/tomatoes.json"
    },
    {
      "LogName": "Heirloom tomato seeds",
      "Action": "Include",
      "FromFile": "assets/json/seeds.json"
    },
    {
      "LogName": "Heirloom tomato crops",
      "Action": "Include",
      "FromFile": "assets/json/crops.json"
    },
    {
      "LogName": "Heirloom tomato shop data",
      "Action": "Include",
      "FromFile": "assets/json/shop_data.json"
    },
    {
      "LogName": "Heirloom tomato recipes",
      "Action": "Include",
      "FromFile": "assets/json/recipes.json"
    },
    {
      "LogName": "Heirloom tomato gift tastes",
      "Action": "Include",
      "FromFile": "assets/json/gift_data.json"
    }
  ]
}
